# Скопируйте этот файл в .env и впишите свои ключи.
# .env не отправляется в Git.

# Ключи Massive API, у фьючерсов и акций подписки разные:
# https://massive.com/dashboard/api-keys
MASSIVE_API_KEY_FUTURES=your_futures_key_here
MASSIVE_API_KEY_STOCKS=your_stocks_key_here

# Общий сетевой диск с данными (Hetzner Storage Box): логин@адрес.
# Команде — общий логин, его выдаёт владелец диска
# (скачивание: python -m src.data.get_data). Пароль спросит rsync.
# Владельцу — главный аккаунт (выгрузка: python -m src.data.upload_data).
STORAGE_BOX=uXXXXXX-subX@uXXXXXX-subX.your-storagebox.de
